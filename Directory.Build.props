<Project>

  <PropertyGroup>
    <!-- Turn .editorconfig style rules (IDE0xxx) into real build warnings -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Enable the full set of built-in .NET analyzers (CAxxxx) at the latest recommended severity -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>

    <!-- Surface nullable-reference warnings project-wide unless a project opts out -->
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Pack every project here on each build and drop it straight into a local folder
         feed, so consumers (e.g. MetroMiles) get a real NuGet package instead of a raw
         HintPath binary reference. Bump Version when a change needs to reach consumers:
         NuGet treats a given Id+Version as immutable once cached, so clear the local
         cache (dotnet nuget locals all clear) after a bump to force re-restore. -->
    <Version>1.0.14-beta.14</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\LocalFeed</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Shared NuGet package metadata; nuget.org shows warnings and mostly refuses
         to render the listing nicely without these, even though they're not
         strictly required to push. -->
    <Authors>Yahya Erdogan</Authors>
    <Company>Yahya Erdogan</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/yahyaerdoan/Core.Packages</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yahyaerdoan/Core.Packages</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ntier;core;layer</PackageTags>
  </PropertyGroup>

</Project>
